# svc- prefix: exeslim's hardening drop-in applies. No hardening here. See
# /etc/systemd/system/svc-.service.d/50-hardening.conf: DynamicUser (the user
# is svc-miniflux, which Postgres peer authentication maps to the miniflux
# role), read-only system, Restart=on-failure.

[Unit]
Description=Miniflux
Wants=postgresql.service
After=postgresql.service

[Service]
ExecStart=/usr/bin/miniflux
# Miniflux sends READY=1 once migrations have run and it is serving, so
# start and restart return only then, or fail.
Type=notify
# The package's config file, shared with `miniflux -config-file`.
EnvironmentFile=/etc/miniflux.conf
# /run/miniflux, owned by the dynamic user: the tailscale flavor's socket.
RuntimeDirectory=miniflux

[Install]
WantedBy=multi-user.target
