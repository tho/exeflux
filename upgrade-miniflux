#!/usr/bin/env bash
# upgrade-miniflux: stop Miniflux, flush its sessions, optionally back up the
# database, install a release .deb in place and start it again.
#
# Usage: sudo upgrade-miniflux [-b backup-path] [-s sha256] <version>
#   -b  pg_dump the database to backup-path first (custom format); if it is
#       a directory, to miniflux.dump in it
#   -s  check the downloaded .deb against this SHA-256. Get it from somewhere
#       other than the download: the release page's checksums share its origin
#       and would be changed along with it.

set -euo pipefail

readonly CONF=/etc/miniflux.conf

usage() {
	echo "usage: ${0##*/} [-b backup-path] [-s sha256] <version>" >&2
	exit 2
}

die() {
	echo "error: $*" >&2
	exit 1
}

# GET /healthcheck wherever LISTEN_ADDR points, a socket path or host:port.
# miniflux -healthcheck auto cannot reach a socket.
healthcheck() {
	local addr
	addr="$(sed -n 's/^LISTEN_ADDR=//p' "$CONF" | tail -n1)"
	if [[ $addr == /* ]]; then
		curl -fsSo /dev/null --unix-socket "$addr" http://localhost/healthcheck
	else
		curl -fsSo /dev/null "http://${addr}/healthcheck"
	fi
}

# Parse arguments.
backup=""
sha256=""
while getopts ":b:s:" opt; do
	case $opt in
		b) backup="$OPTARG" ;;
		s) sha256="${OPTARG,,}" ;;
		*) usage ;;
	esac
done
shift $((OPTIND - 1))
(($# == 1)) || usage

version="$1"
version_re='^[0-9]+\.[0-9]+\.[0-9]+$'
[[ $version =~ $version_re ]] || die "version must look like 2.3.3, got: $version"
sha256_re='^[0-9a-f]{64}$'
[[ -z $sha256 || $sha256 =~ $sha256_re ]] || die "sha256 must be 64 hex digits, got: $sha256"

((EUID == 0)) || die "run as root"

# Migrations only run forward, so a downgrade would leave the old binary on a
# newer schema.
current="$(miniflux -version)" || die "cannot read the installed Miniflux version"
dpkg --compare-versions "$version" gt "$current" ||
	die "$version is not newer than the installed $current"

# Download the release first, so a failed download leaves Miniflux running.
tmp_dir="$(mktemp -d)"
readonly tmp_dir
trap 'rm -rf -- "$tmp_dir"' EXIT

deb="miniflux_${version}_$(dpkg --print-architecture).deb"
curl -fsSLo "$tmp_dir/$deb" "https://github.com/miniflux/v2/releases/download/${version}/${deb}"
if [[ -n $sha256 ]]; then
	echo "$sha256  $tmp_dir/$deb" | sha256sum -c --status - ||
		die "$deb does not match $sha256; nothing upgraded"
fi

# Stop, then flush sessions, per https://miniflux.app/docs/upgrade.html.
# Stopping first means no writes land after the backup and no session is
# created after the flush.
systemctl stop svc-miniflux
miniflux -config-file "$CONF" -flush-sessions

# Back up the database.
if [[ -n $backup ]]; then
	[[ -d $backup ]] && backup="${backup%/}/miniflux.dump"
	echo "backing up database to $backup"

	# Dump beside the target so a failure leaves any previous backup intact.
	# Restoring to /dev/null reads every entry, so a truncated or corrupt dump
	# fails here rather than at restore time (pg_restore -l would not notice).
	if ! (umask 077 && runuser -u postgres -- pg_dump -Fc miniflux >"$backup.tmp") ||
		! pg_restore -f /dev/null "$backup.tmp"; then
		rm -f -- "$backup.tmp"
		systemctl start svc-miniflux
		die "backup failed; nothing upgraded"
	fi
	mv -- "$backup.tmp" "$backup"
fi

# Install and start. Keep our $CONF. The package only restarts
# miniflux.service, which is disabled; svc-miniflux runs migrations
# (RUN_MIGRATIONS=1) on start. The unit is Type=notify, so start returns once
# Miniflux reports ready, or fails within systemd's start timeout.
dpkg -i --force-confold "$tmp_dir/$deb"
systemctl start svc-miniflux || die "svc-miniflux did not start; see: journalctl -u svc-miniflux"
healthcheck
echo "Miniflux $(miniflux -version) is up"
